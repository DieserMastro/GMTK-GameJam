[resource]
script = ExtResource("1_jhcbq")
lines = Array[String](["Thank god you're here!", "The festival starts soon, and we're out of cake!", "Hurry, make a few.", "Start at the table, put the ingredients together and mix the mixture.", "Put the mixture into the oven, but be careful of going too fast!", "Afterwards, put some garnish on top.", "Then the cake is ready for display.", "The cake can be displayed at the showcase on the right."])
